# Quick Click · configuração local
# Copie este arquivo para .env e ajuste. O .env fica fora do Git: segredo nunca vai
# para o código, para o front nem para o repositório.

# Plano do vendedor de demonstração: gratis, essencial, pro ou business
QUICKCLICK_PLANO_DEMO=gratis

# Arquivo do banco SQLite (caminho relativo à raiz do projeto)
QUICKCLICK_BANCO=backend/data/quickclick.sqlite3

# ---------------------------------------------------------------------------
# Credenciais OAuth 2.0 dos marketplaces (ainda não usadas: a integração é simulada).
# Cada uma vem do painel de desenvolvedor do marketplace.
# ---------------------------------------------------------------------------

# Mercado Livre (https://developers.mercadolivre.com.br)
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REDIRECT_URI=

# Shopee Open Platform (https://open.shopee.com)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=

# Amazon Selling Partner API (Seller Central + Login with Amazon)
AMAZON_SP_API_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REDIRECT_URI=
